<h1 class="page-title">Stats <span class="slug"><%= @short_url.slug %></span></h1>

<div class="card">
  <div class="card-fields">
    <div>
      <span class="field-label">Short URL</span>
      <div class="copy-row">
        <span class="field-value mono"><%= short_url_redirect_url(slug: @short_url.slug) %></span>
        <button class="btn btn-copy"
                data-copy-btn
                data-copy-value="<%= short_url_redirect_url(slug: @short_url.slug) %>"
                type="button">Copy</button>
      </div>
    </div>

    <div>
      <span class="field-label">Target URL</span>
      <p class="field-value"><%= @short_url.target_url %></p>
    </div>

    <% if @short_url.title.present? && @short_url.title != "(title unavailable)" %>
      <div>
        <span class="field-label">Page Title</span>
        <p class="field-value"><%= @short_url.title %></p>
      </div>
    <% end %>
  </div>
</div>

<div class="section-gap">
  <%= link_to "Shorten another URL", new_link_path, class: "btn btn-secondary" %>
</div>

<div class="section-gap">
  <div class="stats-meta">
    <span class="click-count"><%= @visits.count %></span>
    <span class="click-label"><%= @visits.count == 1 ? "click" : "clicks" %></span>
  </div>

  <% if @visits.any? %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>Country</th>
            <th>City</th>
            <th>IP Address</th>
          </tr>
        </thead>
        <tbody>
          <% @visits.each do |visit| %>
            <tr>
              <td class="mono"><%= visit.clicked_at.strftime("%Y-%m-%d %H:%M UTC") %></td>
              <td><%= visit.country || "—" %></td>
              <td><%= visit.city || "—" %></td>
              <td class="mono"><%= visit.ip_address %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="empty-state" style="text-align:left; padding: 0;">No visits yet.</p>
  <% end %>
</div>
