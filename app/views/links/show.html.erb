<h1>Stats for <%= @short_url.slug %></h1>

<dl>
  <dt>Short URL</dt>
  <dd><%= short_url_redirect_url(slug: @short_url.slug) %></dd>

  <dt>Target URL</dt>
  <dd><%= @short_url.target_url %></dd>

  <dt>Title</dt>
  <dd><%= @short_url.title %></dd>
</dl>

<p>Total clicks: <%= @visits.count %></p>

<% if @visits.any? %>
  <table>
    <thead>
      <tr>
        <th>Timestamp</th>
        <th>IP Address</th>
        <th>Country</th>
        <th>City</th>
      </tr>
    </thead>
    <tbody>
      <% @visits.each do |visit| %>
        <tr>
          <td><%= visit.clicked_at %></td>
          <td><%= visit.ip_address %></td>
          <td><%= visit.country %></td>
          <td><%= visit.city %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No visits yet.</p>
<% end %>
