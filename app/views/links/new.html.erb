<h1>Shorten a URL</h1>

<%= form_with model: @short_url, url: links_path do |f| %>
  <% if @short_url.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% @short_url.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :target_url, "URL to shorten" %>
    <%= f.url_field :target_url, required: true, placeholder: "https://example.com" %>
  </div>

  <%= f.submit "Shorten" %>
<% end %>
