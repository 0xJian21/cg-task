<h1 class="page-title">Shorten a URL</h1>

<%= form_with model: @short_url, url: links_path do |f| %>
  <div class="form-row">
    <%= f.label :target_url, "Destination URL", class: "form-label" %>
    <%= f.url_field :target_url,
          required: true,
          placeholder: "https://example.com/very/long/path",
          autocomplete: "url",
          class: "form-input #{'is-error' if @short_url.errors[:target_url].any? || @short_url.errors[:base].any?}" %>

    <% @short_url.errors[:target_url].each do |msg| %>
      <p class="form-error"><%= msg.capitalize %></p>
    <% end %>
    <% @short_url.errors[:base].each do |msg| %>
      <p class="form-error"><%= msg %></p>
    <% end %>
  </div>

  <%= f.submit "Shorten", class: "btn btn-primary" %>
<% end %>
