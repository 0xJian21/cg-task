<% content_for :main_class, "site-main--wide" %>

<h1 class="page-title">Reports</h1>

<% if @all_links.any? %>
  <div class="section-title">All links</div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Slug</th>
          <th>Short URL</th>
          <th>Target URL</th>
          <th class="col-right">Clicks</th>
        </tr>
      </thead>
      <tbody>
        <% @all_links.each do |link| %>
          <tr>
            <td class="mono">
              <%= link_to link.slug, link_path(link) %>
            </td>
            <td class="mono">
              <%= link_to short_url_redirect_url(slug: link.slug),
                          short_url_redirect_url(slug: link.slug),
                          target: "_blank", rel: "noopener noreferrer" %>
            </td>
            <td style="max-width: 18rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              <%= link.target_url %>
            </td>
            <td class="col-right"><%= link.click_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @top_countries.any? %>
    <div class="section-gap">
      <div class="section-title">Top countries</div>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Country</th>
              <th class="col-right">Visits</th>
            </tr>
          </thead>
          <tbody>
            <% @top_countries.each do |country, count| %>
              <tr>
                <td><%= country %></td>
                <td class="col-right"><%= count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <div class="section-gap">
    <div class="stats-meta">
      <span class="click-count"><%= @total_clicks %></span>
      <span class="click-label">total <%= @total_clicks == 1 ? "click" : "clicks" %> across all links</span>
    </div>
  </div>

<% else %>
  <p class="empty-state" style="text-align:left; padding: 0;">No links created yet.</p>
<% end %>
